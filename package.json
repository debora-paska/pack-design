{
	"name": "@pack/ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Pack design Storybook — standalone copy of packages/ui kits",
	"packageManager": "pnpm@10.26.1",
	"scripts": {
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"sync": "./scripts/sync-from-pack.sh",
		"tokens": "node build-tokens.js"
	},
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": "./src/lib/index.ts",
		"./lib/*": "./src/lib/*",
		"./theme.css": "./src/styles/theme.css"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@internationalized/date": "^3.12.3",
		"@tailwindcss/forms": "^0.5.7",
		"@tailwindcss/typography": "^0.5.20",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"flowbite": "^2.5.2",
		"flowbite-svelte-icons": "^0.4.5",
		"shadcn-svelte": "^1.3.0",
		"tailwind-merge": "^2.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"peerDependencies": {
		"@lucide/svelte": "^1.16.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.16.0",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-mcp": "^0.7.0",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/svelte-vite": "^10.5.10",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^22",
		"storybook": "^10.5.10",
		"svelte": "^5.53.7",
		"tailwindcss": "4.3.2",
		"typescript": "^5.9.2",
		"vite": "8.0.16"
	}
}
